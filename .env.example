# ---------------------------------------------------------------------------
# Local development (default)
# A local libSQL/SQLite file. Its parent folder is created automatically.
# ---------------------------------------------------------------------------
DATABASE_URL=file:./data/dtektor.db

# ---------------------------------------------------------------------------
# Turso (production / Vercel)
# Use these instead of the local file when deploying to a serverless host.
# ---------------------------------------------------------------------------
# DATABASE_URL=libsql://your-db-your-org.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Shared secret the collector must send as the `x-ingest-secret` header.
# Leave empty to disable the check (local dev only).
# ---------------------------------------------------------------------------
INGEST_SECRET=

# Docker Compose reads .env (Next.js local development reads .env.local).
# Use a nonempty random secret with Compose.
APP_PORT=3000
# Required for Compose. Export the actual source revision before using Compose:
# export DTEKTOR_BUILD_SHA="$(git rev-parse HEAD)"
DTEKTOR_BUILD_SHA=
COLLECT_INTERVAL_SECONDS=300
DEADLINE_MS=45000
# Shared address configuration, used by dashboard and collector.
# ADDRESSES_FILE=/absolute/path/to/addresses.json
# SHOTS_DIR=/absolute/path/to/shots
# DTEKTOR_URL=http://127.0.0.1:3000
