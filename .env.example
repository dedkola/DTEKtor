# ---------------------------------------------------------------------------
# Local development (default)
# A local libSQL/SQLite file. Its parent folder is created automatically.
# ---------------------------------------------------------------------------
DATABASE_URL=file:./data/dtektor.db

# ---------------------------------------------------------------------------
# Turso (production / Vercel)
# Use these instead of the local file when deploying to a serverless host.
# ---------------------------------------------------------------------------
# DATABASE_URL=libsql://your-db-your-org.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---------------------------------------------------------------------------
# Shared secret the collector must send as the `x-ingest-secret` header.
# Leave empty to disable the check (local dev only).
# ---------------------------------------------------------------------------
INGEST_SECRET=
