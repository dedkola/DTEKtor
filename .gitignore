.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn-integrity

# Next.js and build output
.next/
out/
dist/
build/
.vercel/

# TypeScript and tooling caches
*.tsbuildinfo
next-env.d.ts
.cache/
.eslintcache
.stylelintcache
.node_repl_history

# Test coverage and Playwright artifacts
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright-cli/
/output/
/ci-diagnostics/

# Logs and Node.js diagnostic reports
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.json

# Environment files and private keys; keep the shared example
.env*
!.env.example
*.pem
*.key

# Local application data and backups
/data/
/backup/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
